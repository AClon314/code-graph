{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["out/**", "test-results/**", "playwright-report/**", ".code-server/**"],
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "no-console": "off"
  },
  "env": {
    "builtin": true
  }
}
