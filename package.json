{
  "name": "code-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run build:webview && bun run build:extension && bun run build:fresh && bun run verify:runtime",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "jump:bridge": "bun run tools/jump-bridge.ts",
    "jump:client": "bun run tools/jump-client.ts",
    "build:webview": "vite build",
    "build:extension": "esbuild src/extension/vscode.ts --bundle --format=cjs --platform=node --external:vscode --outfile=out/dist/extension.cjs --sourcemap",
    "build:fresh": "esbuild tui/plugin.ts --bundle --format=iife --platform=browser --alias:#host=./src/extension/hosts/fresh.ts --outfile=out/fresh-plugin/code-graph.js --sourcemap",
    "cbm": "codebase-memory-mcp",
    "gui": "bun run gui:private",
    "gui:private": "bash scripts/gui.sh",
    "gui:public": "HOST=0.0.0.0 AUTH=password PASSWORD=${PASSWORD:-cbm} bash scripts/gui.sh",
    "vscode:prepublish": "bun run build",
    "verify:runtime": "bash scripts/verify-runtime.sh",
    "lazy_mkcert": "bun run scripts/lazy-mkcert.ts",
    "tui": "bun run tui/install.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/bun": "latest",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@vscode-elements/elements": "^2.5.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "elkjs": "0.10.2",
    "orchgraph": "^0.2.4",
    "string-width": "8.2.2"
  },
  "displayName": "Code Graph",
  "description": "Call graph and code navigation inside VS Code, backed by codebase-memory-mcp.",
  "publisher": "code-graph",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codeGraph.openCbm",
    "onCommand:codeGraph.openScip"
  ],
  "main": "./out/dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "codeGraph.openCbm",
        "title": "Open (cbm)",
        "category": "Code Graph"
      },
      {
        "command": "codeGraph.openScip",
        "title": "Open (SCIP)",
        "category": "Code Graph"
      }
    ],
    "configuration": {
      "title": "Code Graph",
      "properties": {
        "codeGraph.source": {
          "type": "string",
          "enum": [
            "mock",
            "cbm"
          ],
          "default": "cbm",
          "description": "Graph source. Mock works without a running cbm server."
        },
        "codeGraph.cbmBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:9749",
          "description": "Local cbm HTTP base. Remote/cross-origin backends are not supported; default http://127.0.0.1:9749."
        },
        "codeGraph.project": {
          "type": "string",
          "default": "demo",
          "description": "Initial cbm project name."
        },
        "codeGraph.cbmProject": {
          "type": "string",
          "description": "cbm-native project name for Code Graph (cbm). Falls back to codeGraph.project when omitted."
        },
        "codeGraph.scipProject": {
          "type": "string",
          "description": "scip-cbm-writer project name for Code Graph (SCIP). Falls back to codeGraph.project when omitted."
        },
        "codeGraph.symbolEntry": {
          "type": "string",
          "default": "demo.src.features.useAlias",
          "description": "Initial graph root symbol entry (qualified name or #id)."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  }
}
