{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vscode"
    ],
    "typeRoots": [
      "../../node_modules/@types"
    ],
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "out",
    "rootDir": "src",
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
