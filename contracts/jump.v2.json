{
  "version": 2,
  "transport": "JSON-RPC 2.0 over HTTP",
  "endpoint": "POST /rpc",
  "health": "GET /health",
  "auth": "optional Authorization: Bearer <CODE_NAV_TOKEN>",
  "methods": {
    "jump.open": {
      "params": "JumpOpenParams",
      "result": "JumpReceipt",
      "description": "Enqueue a file:line target for one client (or any client)."
    },
    "jump.next": {
      "params": "JumpNextParams",
      "result": "JumpNextResult | null",
      "description": "Take the next target; waitMs turns this into a long poll."
    },
    "jump.ack": {
      "params": "JumpAckParams",
      "result": "{ ok: true }",
      "description": "Acknowledge a target. Currently informational."
    }
  },
  "errors": {
    "-32700": "Parse error",
    "-32600": "Invalid Request",
    "-32601": "Method not found",
    "-32602": "Invalid params (data contains Ajv errors)",
    "-32603": "Internal error"
  },
  "schemas": "./generated/code-nav.schema.json",
  "source": "./code-nav.tsp",
  "types": "../src/lib/jump/types.ts"
}
