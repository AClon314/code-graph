{
  "version": 1,
  "description": "code-graph -> Fresh/VSCode jump bridge. Lines and columns are 1-based.",
  "endpoints": {
    "POST /jump": {
      "body": "JumpRequest",
      "response": "JumpReceipt"
    },
    "GET /jump/next?client=fresh|vscode": {
      "response": "JumpRequest | 204"
    },
    "POST /jump/ack": {
      "body": "JumpAck"
    },
    "GET /health": {
      "response": "{ ok: true, pending: number }"
    }
  },
  "types": "../src/lib/jump/types.ts"
}
